</Layout>

<style>
  .hero-content {
    display: flex;
    gap: 3rem;
    align-items: center;
  }

  .hero-text {
    flex: 1;
  }

  .hero-content h1 {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
  }

  .hero-role {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }

  .hero-affiliation {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .hero-bio {
    margin-bottom: 1.25rem;
    max-width: 520px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    font-size: 0.95rem;
  }

  .hero-photo {
    flex-shrink: 0;
  }

  .headshot {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
  }

  .pub-category {
    color: var(--color-accent);
    font-size: 1.05rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .pub-category:first-of-type {
    margin-top: 0.5rem;
  }

  .pub-list {
    padding-left: 1.5rem;
  }

  .pub-list li {
    margin-bottom: 1rem;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .pub-list em {
    color: var(--color-text-muted);
  }

  .me {
    color: var(--color-accent);
  }

  .award {
    display: inline-block;
    background: #fff3cd;
    color: #856404;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 500;
    margin-left: 0.3rem;
  }

  .project {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project:last-child {
    border-bottom: none;
  }

  .project h3 {
    margin-bottom: 0.5rem;
  }

  .project p {
    color: var(--color-text-muted);
    font-size: 0.93rem;
    margin-bottom: 0.75rem;
  }

  .project-gifs {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .project-gifs figure {
    text-align: center;
  }

  .project-gifs img {
    max-width: 100%;
    width: 600px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .project-gifs figcaption {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.4rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .exp-entry, .edu-entry {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .exp-entry:last-child, .edu-entry:last-child {
    border-bottom: none;
  }

  .exp-header, .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .exp-date, .edu-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .exp-org, .edu-org {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin-top: 0.15rem;
  }

  .exp-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0.3rem;
  }

  @media (max-width: 640px) {
    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-content h1 {
      font-size: 2rem;
    }

    .hero-links {
      justify-content: center;
    }

    .hero-bio {
      max-width: 100%;
    }

    .interests-list {
      grid-template-columns: 1fr;
    }

    .exp-header, .edu-header {
      flex-direction: column;
    }
  }
</style>
