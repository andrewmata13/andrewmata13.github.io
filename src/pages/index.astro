        <a href="https://amir.rahmati.com/dl/iccps24/ZeroOneAttack-ICCPS24.pdf" target="_blank" rel="noopener" class="pub-link">(pdf)</a>
        <a href="https://stanleybak.com/papers/bak2024iccps_repeatability.pdf" target="_blank" rel="noopener" class="pub-link">(repeatability)</a>
        <span class="award">Best Artifact Evaluation Package Award</span>
        <a href="https://stanleybak.com/perm/iccps2024repeatability.jpg" target="_blank" rel="noopener" class="pub-link">(photo)</a>
