---
import Layout from "../layouts/Layout.astro";
---

<Layout title="CV — Andrew Mata">
  <section class="section">
    <div class="cv-header">
      <h1>Curriculum Vitae</h1>
      <!-- TODO: Add your CV PDF to public/files/cv.pdf -->
      <a href="/files/cv.pdf" class="btn btn-primary" target="_blank" rel="noopener">Download PDF</a>
    </div>

    <div class="cv-section">
      <h2>Education</h2>
      <div class="cv-entry">
        <div class="cv-date">2023 — Present</div>
        <div class="cv-details">
          <!-- TODO: Replace with your actual education -->
          <h3>Ph.D. in Computer Science</h3>
          <p>University Name</p>
          <p class="cv-note">Advisor: Prof. Advisor Name</p>
        </div>
      </div>
      <div class="cv-entry">
        <div class="cv-date">2019 — 2023</div>
        <div class="cv-details">
          <h3>B.S. in Computer Science</h3>
          <p>University Name</p>
          <p class="cv-note">Magna Cum Laude</p>
        </div>
      </div>
    </div>

    <div class="cv-section">
      <h2>Experience</h2>
      <div class="cv-entry">
        <div class="cv-date">Summer 2025</div>
        <div class="cv-details">
          <!-- TODO: Replace with your actual experience -->
          <h3>Research Intern</h3>
          <p>Company / Lab Name</p>
          <p class="cv-note">Worked on [brief description of work and impact].</p>
        </div>
      </div>
      <div class="cv-entry">
        <div class="cv-date">2023 — Present</div>
        <div class="cv-details">
          <h3>Graduate Research Assistant</h3>
          <p>University Name — Lab Name</p>
          <p class="cv-note">Research on [topic]. Published at [venues].</p>
        </div>
      </div>
    </div>

    <div class="cv-section">
      <h2>Skills</h2>
      <div class="skills-grid">
        <!-- TODO: Replace with your actual skills -->
        <div>
          <h3>Languages</h3>
          <p>Python, C++, JavaScript, R</p>
        </div>
        <div>
          <h3>Frameworks</h3>
          <p>PyTorch, TensorFlow, scikit-learn</p>
        </div>
        <div>
          <h3>Tools</h3>
          <p>Git, Docker, LaTeX, Linux</p>
        </div>
      </div>
    </div>

    <div class="cv-section">
      <h2>Awards & Honors</h2>
      <ul class="awards-list">
        <!-- TODO: Replace with your actual awards -->
        <li><strong>Fellowship Name</strong> — University Name, 2023</li>
        <li><strong>Best Paper Award</strong> — Conference Name, 2025</li>
        <li><strong>Dean's List</strong> — University Name, 2019-2023</li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .cv-section {
    margin-top: 2rem;
  }

  .cv-section h2 {
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-accent);
    margin-bottom: 1rem;
  }

  .cv-entry {
    display: flex;
    gap: 1.5rem;
    padding: 0.75rem 0;
  }

  .cv-date {
    min-width: 8rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
    padding-top: 0.15rem;
  }

  .cv-details h3 {
    font-size: 1.05rem;
    margin-bottom: 0.15rem;
  }

  .cv-details p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .cv-note {
    font-size: 0.88rem;
    margin-top: 0.25rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .skills-grid h3 {
    margin-bottom: 0.3rem;
    font-size: 0.95rem;
    color: var(--color-accent);
  }

  .skills-grid p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .awards-list {
    list-style: none;
  }

  .awards-list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
  }

  .awards-list li:last-child {
    border-bottom: none;
  }

  @media (max-width: 640px) {
    .cv-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .cv-entry {
      flex-direction: column;
      gap: 0.25rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
