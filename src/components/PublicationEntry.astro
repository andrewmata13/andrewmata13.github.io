---
interface Props {
  title: string;
  authors: string;
  venue: string;
  year: number;
  link?: string;
  pdf?: string;
}

const { title, authors, venue, year, link, pdf } = Astro.props;
---

<article class="pub-entry">
  <div class="pub-year">{year}</div>
  <div class="pub-details">
    <h3>{title}</h3>
    <p class="pub-authors">{authors}</p>
    <p class="pub-venue">{venue}</p>
    <div class="pub-links">
      {link && <a href={link} target="_blank" rel="noopener">Paper</a>}
      {pdf && <a href={pdf} target="_blank" rel="noopener">PDF</a>}
    </div>
  </div>
</article>

<style>
  .pub-entry {
    display: flex;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .pub-entry:last-child {
    border-bottom: none;
  }

  .pub-year {
    font-weight: 600;
    color: var(--color-accent);
    font-size: 0.9rem;
    min-width: 3rem;
    padding-top: 0.15rem;
  }

  .pub-details h3 {
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }

  .pub-authors {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.2rem;
  }

  .pub-venue {
    font-style: italic;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .pub-links {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .pub-entry {
      flex-direction: column;
      gap: 0.3rem;
    }
  }
</style>
