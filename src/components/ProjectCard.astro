---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link?: string;
  github?: string;
  image?: string;
}

const { title, description, tags, link, github, image } = Astro.props;
---

<article class="project-card">
  {image && <img src={image} alt={title} class="project-image" />}
  <div class="project-content">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="project-tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <div class="project-links">
      {link && <a href={link} class="btn btn-outline" target="_blank" rel="noopener">View Project</a>}
      {github && <a href={github} class="btn btn-outline" target="_blank" rel="noopener">GitHub</a>}
    </div>
  </div>
</article>

<style>
  .project-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .project-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .project-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .project-content {
    padding: 1.25rem;
  }

  .project-content h3 {
    margin-bottom: 0.5rem;
  }

  .project-content p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin-bottom: 0.75rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .project-links {
    display: flex;
    gap: 0.6rem;
  }
</style>
